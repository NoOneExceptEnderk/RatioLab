{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RatioLab mathematical CAD source recipe v1",
  "description": "Structural envelope only. Mechanical bounds, exact sources, digest and derived components MUST be revalidated by the common RatioLab mathematical contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model_revision",
    "family",
    "parameters",
    "frames",
    "references",
    "cad_tolerance_mm",
    "source_sha256",
    "components",
    "accuracy"
  ],
  "properties": {
    "schema": {
      "const": "ratiolab.cad-recipe/1"
    },
    "model_revision": {
      "const": "normal-rack-cylindrical-1"
    },
    "family": {
      "enum": [
        "spur",
        "helical",
        "double",
        "parallel",
        "rack"
      ]
    },
    "parameters": {
      "type": "object"
    },
    "frames": {
      "const": {
        "length": "mm",
        "input_angles": "deg",
        "phase": "rad",
        "handedness": "right",
        "gear_axis": "+Z",
        "rack_translation": "+X",
        "placement": "local XY then world translation"
      }
    },
    "references": {
      "const": [
        "ISO 21771:2007",
        "ISO 53:1998"
      ]
    },
    "cad_tolerance_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "parameters",
          "placement",
          "port"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "cylindrical_gear",
              "circular_extrusion",
              "rack"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "port": {
            "type": "object"
          },
          "placement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "center_mm",
              "z_mm",
              "phase_rad"
            ],
            "properties": {
              "center_mm": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "z_mm": {
                "type": "number"
              },
              "phase_rad": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "accuracy": {
      "type": "object"
    }
  }
}
