include README.md README.it.md INSTALL.md pyproject.toml ratiolab_build.py .gitattributes
include LICENSE COPYRIGHT CONTRIBUTING.md CHANGELOG.md
include VERIFICATION.md packaging/README.md
include MCP.md
include launch.sh RatioLab.desktop bearing-catalog.json hardware-catalog.json
include CALCULATIONS.md KINEMATICS.md HARDWARE.md IO-MODELS.md PRINTED-SHAFT.md VARIANTS.md
include assets/branding/brand.json assets/branding/*.png
