include scripts/*.py scripts/*.sh scripts/*.ps1 scripts/*.iss
include .github/workflows/portable.yml .github/workflows/installers.yml
recursive-include packaging *.py *.spec *.conf *.txt *.json *.ttf *.ico *.icns
include test_*.py
include examples/*.config.json
prune work
prune design
prune outputs
prune generati
prune generated
prune .git
prune .codex
prune .agents
prune .aws
global-exclude *.py[cod] __pycache__ *.token ui-preferences.json preferenze-ui.json custom-materials.json materiali-custom.json
