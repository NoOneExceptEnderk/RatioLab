include Cargo.toml Cargo.lock rust-toolchain.toml
recursive-include rust *.rs Cargo.toml
prune target
include README.md README.it.md pyproject.toml .gitattributes
include LICENSE COPYRIGHT CONTRIBUTING.md CHANGELOG.md
include launch.sh
recursive-include docs *.md *.json
recursive-include src *.py *.json *.png *.manifest
recursive-include src/ratiolab_resources/icons *.theme
recursive-include tests test_*.py *.mjs
recursive-include webapp *.py *.js *.css *.html *.json *.txt
include webapp/notices/*
include build-support/ratiolab_build.py
include assets/screenshots/*.png
include assets/diagrams/*.png
include scripts/*.py scripts/*.sh scripts/*.ps1 scripts/*.iss
include .github/workflows/portable.yml .github/workflows/installers.yml
recursive-include packaging *.py *.spec *.conf *.txt *.json *.ttf *.ttc *.ico *.icns
include examples/*.config.json
prune website
prune _site
prune work
prune design
prune outputs
prune generati
prune generated
prune .git
prune .codex
prune .agents
prune .aws
prune .claude
global-exclude *.py[cod] __pycache__ *.token ui-preferences.json preferenze-ui.json updates.json custom-materials.json materiali-custom.json TODO.md VERIFICATION.md AGENTS.md SKILL.md
